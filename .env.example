# Copy to .env.local and source before running scripts:
#   set -a; source .env.local; set +a
# (.env.local is gitignored)

# --- Required for deploy.sh ---
DOMAIN_NAME=litellm.sirket.com
HOSTED_ZONE_ID=Z1234567890ABC
ALERT_EMAIL=you@company.com

# --- Optional ---
AWS_REGION=us-east-1
STACK_NAME=litellm-proxy
ECR_REPO_NAME=litellm-proxy
IMAGE_TAG=latest
DB_INSTANCE_CLASS=db.t4g.micro

# --- Resource tagging (applied to all stack resources) ---
OWNER=platform-team      # Owner tag — kendi takım/sahip adınla değiştir
STACK_STATE=Prod          # Dev / Staging / Prod
# ProjectName tag is auto-set to STACK_NAME

# --- WAF + build (deploy.sh y/n SORAR, default Y; burada SET edilmezse) ---
# Bu ikisini AÇIK BIRAK (comment) ki deploy.sh interaktif sorabilsin.
# CI/script'te sormasını istemiyorsan değer ver — o zaman prompt atlanır.
# ENABLE_WAF=true          # true → AWS WAF (IP reputation + Bearer-sk + KnownBadInputs)
# SKIP_BUILD=true          # true → docker build atla (sadece CFN); false → image rebuild

# --- Auto-scaling (set via CFN parameters; safe defaults) ---
# MinTaskCount=1
# MaxTaskCount=2
# ScalingTargetRequestsPerTaskPerMinute=1000

# --- Networking (auto-discover default VPC if omitted) ---
# VPC_ID=vpc-xxxxxxxx
# SUBNET_IDS=subnet-aaaa,subnet-bbbb

# --- Used by helper scripts (auto-resolved from Secrets Manager if blank) ---
# MASTER_KEY=sk-...
# PROXY_URL=https://litellm.sirket.com
